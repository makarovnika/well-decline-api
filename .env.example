# Скопируйте файл: cp .env.example .env — и поменяйте значения при необходимости.
# Настоящий .env в репозиторий не попадает (он в .gitignore).
APP_NAME="Well Decline API"
APP_AUTHOR="Nikita Makarov"
LOG_LEVEL=INFO
# Минимальный рентабельный дебит по умолчанию для /wells/{id}/eur, м³/сут
ECONOMIC_LIMIT=5
